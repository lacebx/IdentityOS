{
  "manifest_version": 2,
  "name": "IdentityOS Live Browser Bridge",
  "version": "1.0.0",
  "description": "Connects Firefox to IdentityOS for live browser control",
  "applications": {
    "gecko": {
      "id": "live-browser-bridge@identityos",
      "strict_min_version": "78.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "activeTab",
    "scripting",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "IdentityOS Live Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": ["*://*.identityos.local/*"]
  }
}