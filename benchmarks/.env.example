# Prefer benchmarks/.env for autopilot. Root .env fills missing keys only.
#
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
#
# GROQ_API_KEY=
# GROQ_CODER_MODEL=openai/gpt-oss-20b
# (do NOT use llama-3.3-70b-versatile — deprecated on free/dev)
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_CODER_MODEL=deepseek-v4-flash
# (upgrade only if needed: deepseek-v4-pro — ~3x cost)
#
# Prefer DeepSeek overnight (skip Gemini 503 / Groq TPM):
# AUTOPILOT_CODER_ORDER=deepseek,groq,gemini
#