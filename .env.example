# IdentityOS — Environment Configuration
# Copy this file to .env and configure at least one LLM provider.

# ── Cloud Providers ───────────────────────────────────────────────────
# You only need ONE. Uncomment and fill in your key.
# GROQ_API_KEY="gsk_your_key"   # Free at https://console.groq.com
# OPENAI_API_KEY="sk-your-key"  # https://platform.openai.com
# ANTHROPIC_API_KEY="sk-ant-your-key"  # https://console.anthropic.com
# OPENROUTER_API_KEY="sk-or-your-key"  # https://openrouter.ai
# SAMBANOVA_API_KEY="your-key"  # https://cloud.sambanova.ai

# ── Local Models (OpenAI-compatible endpoints) ───────────────────────
# No API key needed. Just point at your local server.
# OPENAI_BASE_URL="http://localhost:11434/v1"   # Ollama
# OPENAI_BASE_URL="http://localhost:1234/v1"    # LM Studio
# OPENAI_BASE_URL="http://localhost:8000/v1"    # vLLM / llama.cpp / text-gen-webui
# OPENAI_BASE_URL="https://api-inference.huggingface.co/models/..."  # HF Inference
# OPENAI_API_KEY="not-needed"  # Some local servers require a dummy key

# ── Model override (optional) ────────────────────────────────────────
# IDENTITY_MODEL="gpt-4o"
