# IdentityOS — Environment Configuration
# Copy this file to .env and configure at least one LLM provider.

# ── Cloud Providers ───────────────────────────────────────────────────
# You only need ONE. Uncomment and fill in your key.
# GROQ_API_KEY="YOUR_GROQ_API_KEY"   # Free at https://console.groq.com
# GROQ_API_KEY_2="YOUR_GROQ_API_KEY" # Additional keys for rotation
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"  # https://platform.openai.com
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"  # https://console.anthropic.com
# OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"  # https://openrouter.ai
# SAMBANOVA_API_KEY="YOUR_SAMBANOVA_API_KEY"  # https://cloud.sambanova.ai
# CEREBRAS_API_KEY="YOUR_CEREBRAS_API_KEY"  # https://inference.cerebras.ai
# CEREBRAS_API_KEY_2="YOUR_CEREBRAS_API_KEY"  # Additional keys for rotation

# ── GitHub (for authenticated API access, 5000 requests/hr instead of 60) ──
# GITHUB_TOKEN="YOUR_GITHUB_TOKEN"

# ── Local Models (OpenAI-compatible endpoints) ───────────────────────
# No API key needed. Just point at your local server.
# OPENAI_BASE_URL="http://localhost:11434/v1"   # Ollama
# OPENAI_BASE_URL="http://localhost:1234/v1"    # LM Studio
# OPENAI_BASE_URL="http://localhost:8000/v1"    # vLLM / llama.cpp / text-gen-webui
# OPENAI_BASE_URL="https://api-inference.huggingface.co/models/..."  # HF Inference
# OPENAI_API_KEY="not-needed"  # Some local servers require a dummy key

# ── Model override (optional) ────────────────────────────────────────
# IDENTITY_MODEL="gpt-4o"


# ── Ratchet autopilot (Gemini coder; optional) ───────────────────────
# Prefer benchmarks/.env so this root file can stay for provider secrets.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
