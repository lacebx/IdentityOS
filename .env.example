# IdentityOS — Environment Configuration
# Copy this file to .env and configure at least one LLM provider.

# ── Cloud Providers ───────────────────────────────────────────────────
# You only need ONE. Uncomment and fill in your key.
# GROQ_API_KEY="YOUR_GROQ_API_KEY"   # Free at https://console.groq.com
# GROQ_API_KEY_2="YOUR_GROQ_API_KEY" # Additional keys for rotation
# OPENAI_API_KEY="YOUR_OPENAI_API_KEY"  # https://platform.openai.com
# OPENAI_TIMEOUT="120"  # Positive request timeout in seconds (default: 120)
# ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"  # https://console.anthropic.com
# OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"  # https://openrouter.ai
# SAMBANOVA_API_KEY="YOUR_SAMBANOVA_API_KEY"  # https://cloud.sambanova.ai
# CEREBRAS_API_KEY="YOUR_CEREBRAS_API_KEY"  # https://inference.cerebras.ai
# CEREBRAS_API_KEY_2="YOUR_CEREBRAS_API_KEY"  # Additional keys for rotation

# ── Multiple OpenAI-Compatible Providers ──────────────────────────────
# Configure MULTIPLE OpenAI-compatible endpoints simultaneously!
# Pattern: OPENAI_<NAME>_API_KEY, OPENAI_<NAME>_BASE_URL, OPENAI_<NAME>_MODEL
# Each will appear as a separate adapter option in the chat selector.
#
# OPENAI_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"  # Google AI Studio: https://aistudio.google.com
# OPENAI_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# OPENAI_GEMINI_MODEL="gemini-1.5-flash"
#
# OPENAI_NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"  # NVIDIA: https://build.nvidia.com
# OPENAI_NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# OPENAI_NVIDIA_MODEL="nvidia/nemotron-3-ultra"
#
# OPENAI_TOGETHER_API_KEY="YOUR_TOGETHER_API_KEY"  # Together AI: https://api.together.ai
# OPENAI_TOGETHER_BASE_URL="https://api.together.xyz/v1"
# OPENAI_TOGETHER_MODEL="meta-llama/Meta-Llama-3.1-70B-Instruct"
#
# OPENAI_PERPLEXITY_API_KEY="YOUR_PERPLEXITY_API_KEY"  # Perplexity: https://www.perplexity.ai
# OPENAI_PERPLEXITY_BASE_URL="https://api.perplexity.ai"
# OPENAI_PERPLEXITY_MODEL="llama-3.1-sonar-large-128k-online"
#
# OPENAI_DEEPSEEK_API_KEY="YOUR_DEEPSEEK_API_KEY"  # DeepSeek: https://platform.deepseek.com
# OPENAI_DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# OPENAI_DEEPSEEK_MODEL="deepseek-chat"

# ── GitHub (for authenticated API access, 5000 requests/hr instead of 60) ──
# GITHUB_TOKEN="YOUR_GITHUB_TOKEN"

# ── Browser capability (optional autonomous surfing) ──────────────────
# pip install -e ".[browser]" && playwright install chromium
# Then: identity cap install browser --identity <id>
# Or:   identity isp install surfer --identity <id>
# Login additionally requires:
# identity cap grant browser --identity <id> --permission browser:credentials

# ── Local Models (OpenAI-compatible endpoints) ───────────────────────
# No API key needed. Just point at your local server.
# OPENAI_BASE_URL="http://localhost:11434/v1"   # Ollama
# OPENAI_BASE_URL="http://localhost:1234/v1"    # LM Studio
# OPENAI_BASE_URL="http://localhost:8000/v1"    # vLLM / llama.cpp / text-gen-webui
# OPENAI_BASE_URL="https://api-inference.huggingface.co/models/..."  # HF Inference
# OPENAI_API_KEY="not-needed"  # Some local servers require a dummy key
# OPENAI_TIMEOUT="120"  # Also applies to OpenAI-compatible local endpoints

# ── Explicit Ollama (alternative to OPENAI_BASE_URL for local) ─────────
# OLLAMA_API_KEY="ollama"  # Dummy key
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3.2"

# ── Model override (optional) ────────────────────────────────────────
# IDENTITY_MODEL="gpt-4o"


# ── Ratchet autopilot (optional; prefer benchmarks/.env) ─────────────
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_CODER_MODEL=openai/gpt-oss-20b
# DEEPSEEK_API_KEY=
# DEEPSEEK_CODER_MODEL=deepseek-v4-flash
# AUTOPILOT_CODER_ORDER=deepseek,groq,gemini